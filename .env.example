# ── Rustik Evi ortam değişkenleri ───────────────────────────────
# cp .env.example .env  →  aşağıdaki "değiştir" yazan değerleri doldurun.
# Güçlü değer üretmek için:  openssl rand -base64 48

# PostgreSQL
POSTGRES_DB=rustikevi
POSTGRES_USER=rustikevi
POSTGRES_PASSWORD=degistir_guclu_bir_sifre

# JWT (en az 32 karakter, rastgele)
JWT_SECRET=degistir_openssl_rand_base64_48
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Dış portlar
WEB_PORT=3000
ADMIN_PORT=3002
# Sadece 127.0.0.1'e açılır (yerel bakım için)
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# Admin/site farklı alan adlarından API'ye doğrudan erişecekse (normalde gerekmez)
CORS_ORIGIN=http://localhost:3002,http://localhost:3000

# İlk açılışta, hiç kullanıcı yoksa oluşturulacak admin (production'da en az 12 karakter)
SEED_ADMIN_EMAIL=admin@rustikevi.com
SEED_ADMIN_PASSWORD=degistir_en_az_12_karakter

LOG_LEVEL=info

# ── Yerel geliştirme (pnpm dev) için ────────────────────────────
# DATABASE_URL=postgresql://rustikevi:SIFRE@localhost:5432/rustikevi
# REDIS_URL=redis://localhost:6379
