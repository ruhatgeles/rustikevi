# PostgreSQL
POSTGRES_DB=rustikevi
POSTGRES_USER=rustikevi
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://rustikevi:change_me_in_production@postgres:5432/rustikevi

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change_me_to_random_64_char_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3002

# Admin
ADMIN_PORT=3002
VITE_API_URL=http://localhost:3001

# Frontend
WEB_PORT=3000

# Seed
SEED_ADMIN_EMAIL=admin@rustikevi.com
SEED_ADMIN_PASSWORD=admin123
