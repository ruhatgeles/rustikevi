# ── Rustik Evi ortam değişkenleri ───────────────────────────────
# cp .env.example .env  →  aşağıdaki BOŞ bırakılmış değerleri doldurun.
# Boş bırakılırsa docker compose başlamaz (POSTGRES_PASSWORD, JWT_SECRET) veya ilk admin oluşturulmaz (SEED_ADMIN_PASSWORD).
# Güçlü değer üretmek için:  openssl rand -base64 48

# PostgreSQL
POSTGRES_DB=rustikevi
POSTGRES_USER=rustikevi
# ZORUNLU: güçlü, rastgele bir şifre
POSTGRES_PASSWORD=

# JWT — ZORUNLU: en az 32 karakter, rastgele (openssl rand -base64 48)
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Dış portlar
WEB_PORT=3000
ADMIN_PORT=3002
# Sadece 127.0.0.1'e açılır (yerel bakım için)
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# Admin/site farklı alan adlarından API'ye doğrudan erişecekse (normalde gerekmez)
CORS_ORIGIN=http://localhost:3002,http://localhost:3000

# İlk açılışta, hiç kullanıcı yoksa oluşturulacak admin.
# ZORUNLU (ilk kurulumda): production'da en az 12 karakter; örnek/varsayılan şifreler reddedilir.
SEED_ADMIN_EMAIL=admin@rustikevi.com
SEED_ADMIN_PASSWORD=

LOG_LEVEL=info

# ── Yerel geliştirme (pnpm dev) için ────────────────────────────
# DATABASE_URL=postgresql://rustikevi:SIFRE@localhost:5432/rustikevi
# REDIS_URL=redis://localhost:6379
